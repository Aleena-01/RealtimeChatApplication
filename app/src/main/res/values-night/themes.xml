<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RealtimeApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/background</item> <!-- Black background -->
        <item name="colorSurface">@color/surface</item> <!-- Dark gray surface -->
        <item name="colorOnSurface">@color/onSurface</item>
    </style>

    <style name="Theme.RealtimeApplication" parent="Base.Theme.RealtimeApplication" />

    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
